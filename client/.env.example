# Firebase config used by client/src/firebase.js
# Copy this file to `.env` (or a pair like `.env.local`) and fill in values
# for a different Firebase project if you don't want to use the defaults that
# are hard-coded in src/firebase.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# URL of the bug-detector backend (used by App.jsx)
VITE_API_URL=http://localhost:5000